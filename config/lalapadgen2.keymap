#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_LAYER   0
#define SECONDARY_LAYER 1
#define TERTIARY_LAYER  2
#define SYSTEM_LAYER    3

&mt { quick-tap-ms = <200>; };

&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        tap_dance_layer_1and2: tap_dance_layer_1and2 {
            compatible = "zmk,behavior-tap-dance";
            label = "td_mo12";
            #binding-cells = <0>;
            bindings = <&mo 2>, <&mo 5>;
        };
    };

    combos {
        compatible = "zmk,combos";

        CONBO_ESC {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        COMBO_TAB {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        Left_Parenthesis {
            bindings = <&kp LS(NUMBER_8)>;
            key-positions = <5 6>;
        };

        Right_Parenthesis {
            bindings = <&kp LS(NUMBER_9)>;
            key-positions = <6 7>;
        };

        Left_Bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <15 16>;
        };

        Right_Bracket {
            bindings = <&kp BACKSLASH>;
            key-positions = <16 17>;
        };

        Left_Brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <25 26>;
        };

        Right_Brace {
            bindings = <&kp LS(BACKSLASH)>;
            key-positions = <26 27>;
        };

        copy {
            bindings = <&kp LC(C)>;
            key-positions = <12 11>;
        };

        cut {
            bindings = <&kp LC(X)>;
            key-positions = <23 22>;
        };

        paste {
            bindings = <&kp LC(V)>;
            key-positions = <13 12>;
        };

        undo {
            bindings = <&kp LC(Z)>;
            key-positions = <21 22>;
        };
    };

    macros {
        mc_at: at {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp INT_MUHENKAN &kp LEFT_BRACKET>;
            label = "AT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            display-name = "Default";
            bindings = <
&mt ESCAPE Q       &kp W      &kp E          &kp R                  &kp T                                            &kp Y        &kp U                  &kp I          &kp O       &kp P
&mt LCTRL A        &kp S      &kp D          &kp F                  &kp G                                            &kp H        &kp J                  &kp K          &kp L       &mt2 EQUAL MINUS
&mt2 LEFT_SHIFT Z  &kp X      &kp C          &kp V                  &kp B                                            &kp N        &kp M                  &kp COMMA      &kp PERIOD  &mt RIGHT_SHIFT SLASH
&kp LCTRL          &kp LWIN   &kp LEFT_ALT   &lt 3 INTERNATIONAL_5  &lt 3 SPACE   &kp DEL     &kp BACKSPACE          &lt 2 ENTER  &lt 2 INTERNATIONAL_4  &mc_at         &kp EQUAL   &kp BACKSLASH
                   &none      &kp LG(RIGHT)  &kp LG(DOWN)           &kp LG(LEFT)  &kp LG(UP)  &kp LC(LS(SEMICOLON))  &kp PAGE_UP  &kp LC(MINUS)          &kp PAGE_DOWN  &none
&mkp LCLK          &mkp RCLK  &mkp MCLK                                                                                                                  &mkp LCLK      &none       &none
&mkp MB4           &mkp MB5   &kp LG(TAB)    &kp LG(D)              &kp LCTRL                                        &none        &none                  &none          &none       &kp LCTRL
            >;
        };

        APPLE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans                                                  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
            >;
        };

        ARROW_LAYER {
            display-name = "tertiary_layer";
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN    &kp HASH      &kp DOLLAR            &kp PERCENT                            &mkp MB1  &kp HOME  &kp UP_ARROW    &kp END    &kp PRINTSCREEN
&kp LCTRL        &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                  &mkp MB2  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT  &kp SCROLLLOCK
&kp LEFT_SHIFT   &kp SQT        &kp SEMI      &kp LEFT_BRACKET      &kp RIGHT_BRACKET                      &mkp MB3  &mkp MB4  &trans          &mkp MB5   &kp PAUSE_BREAK
&trans           &trans         &trans        &trans                &kp TAB                &trans  &trans  &trans    &trans    &trans          &trans     &trans
                 &trans         &trans        &trans                &trans                 &trans  &trans  &trans    &trans    &trans          &trans
&trans           &trans         &trans                                                                                         &trans          &trans     &trans
&trans           &trans         &trans        &trans                &trans                                 &trans    &trans    &trans          &trans     &trans
            >;
        };

        NUM_BAR {
            bindings = <
&kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)                  &kp LS(N6)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &kp LS(N0)
&kp N1      &kp N2      &kp N3      &kp N4      &kp N5                      &kp N6      &kp N7      &kp N8      &kp N9      &kp N0
&trans      &trans      &trans      &trans      &trans                      &trans      &trans      &trans      &trans      &trans
&trans      &trans      &trans      &trans      &trans      &trans  &trans  &trans      &trans      &trans      &trans      &trans
            &trans      &trans      &trans      &trans      &trans  &trans  &trans      &trans      &trans      &trans
&trans      &trans      &trans                                                                      &trans      &trans      &trans
&trans      &trans      &trans      &trans      &trans                      &trans      &trans      &trans      &trans      &trans
            >;
        };

        SECONDARY_LAYER {
            display-name = "secondary_layer";
            bindings = <
&kp NUMBER_1      &kp NUMBER_2       &kp NUMBER_3  &kp NUMBER_4  &kp N5                    &kp KP_NUMLOCK    &kp KP_NUMBER_7    &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS
&kp NUMBER_6      &kp N7             &kp N8        &kp N9        &kp N0                    &trans            &kp KP_NUMBER_4    &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS
&kp F6            &kp F7             &kp F8        &kp F9        &kp F10                   &trans            &kp KP_NUMBER_1    &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_ASTERISK
&trans            &trans             &trans        &trans        &trans   &trans  &kp DEL  &trans            &trans             &kp KP_NUMBER_0  &kp KP_DOT       &kp KP_DIVIDE
                  &trans             &trans        &trans        &trans   &trans  &trans   &trans            &trans             &trans           &trans
&trans            &trans             &trans                                                                                     &trans           &trans           &trans
&kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans        &trans        &trans                    &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans           &trans           &trans
            >;
        };

        SYSTEM_LAYER {
            display-name = "system_layer";
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5                   &out OUT_TOG                   &bt BT_SEL 0                   &bt BT_SEL 1                   &bt BT_SEL 2                   &bt BT_SEL 3
&kp F6   &kp F7   &kp F8   &kp F9   &kp F10                  &sys_reset                     &bootloader                    &bt BT_CLR                     &bt BT_CLR_ALL                 &trans
&kp F11  &kp F12  &kp F13  &kp F14  &kp F15                  &zip_dyn_scale ZDS_XY ZDS_INC  &zip_dyn_scale ZDS_XY ZDS_DEC  &zip_dyn_scale ZDS_SC ZDS_INC  &zip_dyn_scale ZDS_SC ZDS_DEC  &zip_dyn_scale ZDS_ALL ZDS_RST
&trans   &trans   &trans   &trans   &trans   &trans  &trans  &trans                         &trans                         &trans                         &trans                         &trans
         &trans   &trans   &trans   &trans   &trans  &trans  &trans                         &trans                         &trans                         &trans
&trans   &trans   &trans                                                                                                   &trans                         &trans                         &trans
&trans   &trans   &trans   &trans   &trans                   &trans                         &trans                         &trans                         &trans                         &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Cond_Syslayer {
            if-layers = <2 5>;
            then-layer = <5>;
        };
    };
};
